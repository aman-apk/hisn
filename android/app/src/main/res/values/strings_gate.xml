    <string name="create_password_note">كلمة السرّ الرئيسية هي مفتاح خزنتك الوحيد؛ إن نُسيت فلا سبيل إلى استرجاعها ولا إلى فتح الخزنة.</string>
    <string name="create_button">إنشاء الخزنة</string>
