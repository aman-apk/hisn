<?xml version="1.0" encoding="utf-8"?>
<!--
  The XML theme only has to carry the app until Compose takes over: the window background it
  paints is what the user sees between tapping the icon and the first composition. Everything
  after that is styled by HisnTheme in ui/theme/Theme.kt.

  The bars are transparent and follow the theme — the family way (enableEdgeToEdge in
  MainActivity owns them from the first composition on). A fixed dark bar here used to pair
  with dark icons from MainActivity in light mode on Android <15: invisible icons. The
  window background is the family's warm paper (#FBF8F2), matching Compose's light ground
  so there is no colour jump at startup.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Hisn" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hisn_copper_strong</item>
        <item name="colorOnPrimary">@color/hisn_surface_light</item>
        <item name="colorPrimaryContainer">@color/hisn_brass</item>
        <item name="colorOnPrimaryContainer">@color/hisn_copper_deep</item>
        <item name="colorSecondary">@color/hisn_copper_deep</item>
        <item name="colorOnSecondary">@color/hisn_surface_light</item>
        <item name="colorError">@color/hisn_rust</item>
        <item name="colorOnError">@color/hisn_surface_light</item>
        <item name="android:colorBackground">@color/hisn_bg_light</item>
        <item name="colorSurface">@color/hisn_surface_light</item>
        <item name="colorOnSurface">@color/hisn_on_light</item>

        <!-- Family warm paper, literal so the first frame cannot drift from Compose. -->
        <item name="android:windowBackground">#FBF8F2</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Light ground behind transparent bars, so their icons must be dark. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <item name="android:textColorPrimary">@color/hisn_on_light</item>
        <item name="android:textColorSecondary">@color/hisn_muted</item>
    </style>

    <!--
      The three autofill screens. They appear over another app's login form, so the window itself
      is see-through and the panel — scrim included — is drawn by Compose; that keeps one set of
      brand colours instead of splitting them between a platform dialog frame and the content.

      The name has no explicit parent on purpose: "Theme.Hisn.Autofill" inherits from whichever
      "Theme.Hisn" the current configuration resolves, so the night variant still applies.

      The bars are transparent rather than the usual dark copper: this window is a panel over
      someone else's app, and painting their status bar would be a lie about what is running.
    -->
    <style name="Theme.Hisn.Autofill">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
