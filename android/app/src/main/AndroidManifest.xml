<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Hisn is an offline vault: nothing is uploaded anywhere, and there is no analytics, telemetry
      or crash reporting. INTERNET is nevertheless required, because the optional "sync over the
      local network" feature opens a socket straight to another device on the same Wi-Fi — peer to
      peer, no intermediary — and Android gates every socket, including a purely local one, behind
      this permission.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Lets sync say *why* it cannot run ("you are not on a Wi-Fi network") instead of failing with
      a bare timeout, and lets it pick the right interface to listen on.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Unlocking the vault with a fingerprint, face or device credential. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- API 26–27 predates USE_BIOMETRIC; BiometricPrompt falls back to this there. -->
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="27" />

    <!--
      android.permission.CAMERA is deliberately absent.

      Device pairing was sketched as a QR scan, which would need it, but the implemented flow has
      the user type a short pairing code instead (ui/screens/SyncScreen.kt). Declaring camera
      access an app never exercises is exactly what a password manager should not do. Add it back
      in the same change that adds a scanner, not before.
    -->

    <!--
      android.permission.POST_NOTIFICATIONS is deliberately absent too.

      The only notification Hisn ever posts is the Aman family's monthly support reminder
      (support/SupportReminder.kt), and a donation reminder is no reason to ask for a runtime
      permission — Jezdan's precedent, kept family-wide. Where the platform needs no permission
      (API 26–32) it fires on its silent, low-importance channel; on Android 13+ the missing
      permission keeps it quiet for good: areNotificationsEnabled() reports false and nothing
      is posted. The system's notification settings remain the user's own off-switch.
    -->

    <!-- Sync is optional, so a device with no Wi-Fi radio is still fully usable. -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hisn"
        tools:targetApi="33">

        <!--
          One activity for the whole app; Compose navigation handles the rest.

          singleTask so that returning from the file picker, the biometric prompt or a browser
          re-enters the running instance instead of stacking a second copy of an unlocked vault.
          adjustResize so the password field stays visible above the keyboard.

          No ACTION_VIEW filter: databases are opened through the Storage Access Framework, which
          hands back a persistable URI. A filter here would let a file manager launch Hisn with a
          one-shot URI it has no permission to keep, and the user would be back at the unlock
          screen with nothing opened.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Hisn">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ============================================================ autofill

          The Autofill framework binds this service directly, so it must be exported — and
          android:permission is what makes that safe: only the system, which holds
          BIND_AUTOFILL_SERVICE, can bind to it. Without that line any app on the device could.

          The user still has to pick Hisn as their autofill service in system settings before a
          single request arrives; the settings screen has a row that takes them there.
        -->
        <service
            android:name=".autofill.HisnAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!--
          The three screens of the fill flow.

          exported="false" throughout: they are only ever started through a PendingIntent this
          app created, which carries our identity, so nothing else can invoke them. They are
          translucent dialogs over whatever app asked to be filled, and excluded from recents
          because a thumbnail of an open vault in the task switcher would undo FLAG_SECURE. The
          flag itself is applied in code, reconciled with HisnSettings.blockScreenshots exactly
          as MainActivity does it.

          No launchMode and no task flags on the two that answer the framework: the platform
          starts them *for result* from the requesting app's activity, and a new task would make
          that result come back as "cancelled" before the user had typed anything.
        -->
        <activity
            android:name=".autofill.AutofillUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Hisn.Autofill" />

        <activity
            android:name=".autofill.AutofillPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Hisn.Autofill" />

        <!--
          The save prompt is the one that is started on its own, after the platform's own "save
          this login?" bar has already been accepted, so it gets an empty task affinity: it must
          not surface inside — or drag forward — the main app's task.
        -->
        <activity
            android:name=".autofill.AutofillSaveActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Hisn.Autofill" />

        <!--
          Hands an exported database or a decrypted attachment to another app as a short-lived
          content:// URI, so nothing has to be written to shared storage where any app could read
          it. The two directories it may serve are listed in res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Dismisses the current support reminder on «لاحقًا». Not exported: it is only ever
          reached through the explicit PendingIntent the notification itself carries, and it
          adds no uses-permission. The reminder follows family standards §5: monthly — the
          first 30 days after first use, then one every 30 days, anchored to the last one
          actually shown (support/SupportReminder.kt).
        -->
        <receiver
            android:name=".support.SupportReminderReceiver"
            android:exported="false" />

        <!--
          Clipboard safety net: wipes the primary clip when the copy timeout arrives after
          Android has killed the process — the in-process timer cancels the alarm when it wins.
          Not exported, reached only through the app's own PendingIntent, and it adds no
          uses-permission: the alarm is an inexact setWindow, which needs no SCHEDULE_EXACT_ALARM.
        -->
        <receiver
            android:name=".data.ClipboardClearReceiver"
            android:exported="false" />
        <!-- عقد «باكأب أمان»: قاعدة kdbx (المشفّرة بكلمتها الرئيسية) تُضم للنسخة الموحّدة — بقرار المالك. -->
        <provider
            android:name=".backup.FamilyBackupProvider"
            android:authorities="org.amanlabs.hisn.backup"
            android:exported="true" />

    </application>

</manifest>
