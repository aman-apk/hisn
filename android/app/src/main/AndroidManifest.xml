<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Hisn is an offline vault: nothing is uploaded anywhere, and there is no analytics, telemetry
      or crash reporting. INTERNET is nevertheless required, because the optional "sync over the
      local network" feature opens a socket straight to another device on the same Wi-Fi — peer to
      peer, no intermediary — and Android gates every socket, including a purely local one, behind
      this permission.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Lets sync say *why* it cannot run ("you are not on a Wi-Fi network") instead of failing with
      a bare timeout, and lets it pick the right interface to listen on.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Unlocking the vault with a fingerprint, face or device credential. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- API 26–27 predates USE_BIOMETRIC; BiometricPrompt falls back to this there. -->
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="27" />

    <!--
      android.permission.CAMERA is deliberately absent.

      Device pairing was sketched as a QR scan, which would need it, but the implemented flow has
      the user type a short pairing code instead (ui/screens/SyncScreen.kt). Declaring camera
      access an app never exercises is exactly what a password manager should not do. Add it back
      in the same change that adds a scanner, not before.
    -->

    <!-- Sync is optional, so a device with no Wi-Fi radio is still fully usable. -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hisn"
        tools:targetApi="33">

        <!--
          One activity for the whole app; Compose navigation handles the rest.

          singleTask so that returning from the file picker, the biometric prompt or a browser
          re-enters the running instance instead of stacking a second copy of an unlocked vault.
          adjustResize so the password field stays visible above the keyboard.

          No ACTION_VIEW filter: databases are opened through the Storage Access Framework, which
          hands back a persistable URI. A filter here would let a file manager launch Hisn with a
          one-shot URI it has no permission to keep, and the user would be back at the unlock
          screen with nothing opened.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Hisn">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Hands an exported database or a decrypted attachment to another app as a short-lived
          content:// URI, so nothing has to be written to shared storage where any app could read
          it. The two directories it may serve are listed in res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
